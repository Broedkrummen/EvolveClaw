{
  "name": "evolveclaw",
  "version": "0.3.0",
  "description": "OpenClaw plugin that evolves the agent's system prompt using SCOPE (Self-evolving Context Optimization via Prompt Evolution)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Broedkrummen/EvolveClaw.git"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "prompt-evolution",
    "scope",
    "self-improving",
    "guidelines"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.2",
      "minGatewayVersion": "2026.10.2"
    },
    "build": {
      "openclawVersion": "2026.10.2",
      "pluginSdkVersion": "2026.10.2"
    }
  },
  "files": [
    "dist/",
    "server/",
    "!server/.env",
    "!server/.env.local",
    "!server/.env.bak",
    "!server/venv/",
    "!server/.venv/",
    "!server/__pycache__/",
    "!server/scope_data/",
    "scripts/",
    "docs/",
    "openclaw.plugin.json",
    "evaluation/",
    "!evaluation/__pycache__/"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.16.0 || >=26.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "test:ui": "playwright test",
    "eval:pilot": "python3 -m evaluation pilot --output artifacts/evaluation/pilot"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.0",
    "openclaw": "2026.10.2",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "typebox": "1.3.34"
  }
}
